<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_cover_shade"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_logo" android:contentDescription="@null" />
                <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                    android:text="MKW" android:letterSpacing="0.14" android:textColor="#D9FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="MKW Music" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="Нажмите, чтобы открыть" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/wg_btn_main" android:src="@drawable/wg_ic_play"
            android:scaleType="fitCenter" android:padding="11dp" android:contentDescription="Играть или пауза" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
