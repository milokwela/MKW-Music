<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wg_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/wg_shade"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageView android:id="@+id/w_cover" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/wg_cover_frame"
            android:scaleType="centerCrop" android:src="@drawable/widget_logo" android:padding="0dp" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_logo" android:contentDescription="@null" />
                <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                    android:text="MKW MUSIC" android:letterSpacing="0.14" android:textColor="#D9FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="MKW Music" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="Нажмите, чтобы открыть" android:textColor="#B3FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/wg_btn" android:src="@drawable/wg_ic_prev"
            android:scaleType="fitCenter" android:padding="9dp" android:contentDescription="Назад" /><FrameLayout android:layout_width="4dp" android:layout_height="1dp" /><ImageButton android:id="@+id/w_play" android:layout_width="46dp" android:layout_height="46dp"
            android:background="@drawable/wg_btn_main" android:src="@drawable/wg_ic_play"
            android:scaleType="fitCenter" android:padding="11dp" android:contentDescription="Играть или пауза" /><FrameLayout android:layout_width="4dp" android:layout_height="1dp" /><ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/wg_btn" android:src="@drawable/wg_ic_next"
            android:scaleType="fitCenter" android:padding="9dp" android:contentDescription="Дальше" />
    </LinearLayout>
</FrameLayout>
