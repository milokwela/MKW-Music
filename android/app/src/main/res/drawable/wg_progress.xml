<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><size android:height="5dp" /><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" /><size android:height="5dp" /><gradient android:angle="0" android:startColor="#FFFFC2DC" android:endColor="#FFFFFFFF" /></shape></clip>
    </item>
</layer-list>
