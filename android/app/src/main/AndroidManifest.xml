<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Что нужно приложению и зачем:
         интернет — чтобы открыть сайт; уведомления — сообщения, звонки и кнопки музыки в шторке;
         фоновое воспроизведение и «без ограничений» — чтобы музыка не обрывалась при выключенном экране;
         камера и микрофон — только когда вы сами включаете жесты, голос, распознавание песни или звонок. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- обновление прямо в приложении: Android всё равно спрашивает подтверждение у человека -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- входящий звонок MKW: показать поверх экрана блокировки, как обычный звонок -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth: найти и подключить наушники или колонку из меню «Подключить устройство», показать их заряд.
         Спрашивается только по нажатию «Найти устройства». Геолокация не используется. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+: без этого приложение не «видит» сервисы Google и решило бы, что их нет -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MKW"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <!-- Firebase не запрашивает токен уведомлений сам при запуске: на телефонах без сервисов Google
             (Huawei, Honor) это бесполезные повторные попытки. Токен просим вручную, только если сервисы Google есть -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Продолжить с сайта»: страница mkwmusic.ru в браузере возвращает вход сюда.
                 Принимается только с одноразовым кодом, который приложение само выдало (см. MainActivity). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mkwmusic" android:host="handoff" />
            </intent-filter>
        </activity>

        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Виджеты на рабочий стол: мини-плеер, плеер с перемоткой, MKW Волна, обложка -->
        <receiver android:name=".PlayerWidget" android:exported="true" android:label="@string/wn_mini">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_player_info" />
        </receiver>
        <receiver android:name=".SeekWidget" android:exported="true" android:label="@string/wn_seek">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_seek_info" />
        </receiver>
        <receiver android:name=".WaveWidget" android:exported="true" android:label="@string/wn_wave">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wave_info" />
        </receiver>
        <receiver android:name=".CoverWidget" android:exported="true" android:label="@string/wn_cover">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_cover_info" />
        </receiver>
    </application>
</manifest>
