rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // создатель MKW Music (milokwel). Его uid не меняется при смене почты/ника, в отличие от токена с почтой
    function isOwner() { return request.auth != null && request.auth.uid == 'IqBq9kGF1oZG4Iz0m6LU1nSyx5H2'; }
    // зарезервированные ники (как RESERVED в auth.js): в публичных карточках их может писать только создатель
    function nickFree(d) {
      return !(d.nick.lower() in ['milokq', 'milokwel', 'milokw', 'milokwela', 'milo_kwel', 'admin', 'mkw', 'mkwmusic', 'moderator', 'support', 'razrab'])
        || isOwner();
    }
    // необязательное текстовое поле не длиннее n символов
    function optStr(d, k, n) { return !(k in d) || !(d[k] is string) || d[k].size() <= n; }
    // необязательное число от 0 до max — нельзя записать себе отрицательные или «бесконечные» часы и лайки
    function nonNeg(d, k, max) { return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= max); }
    // номер фаната в карточке — только свой настоящий (из fans/{uid}); чужой или выдуманный номер записать нельзя
    function fanOk(d, uid) {
      return !('fan' in d) || d.fan == 0 || isOwner()
        || (exists(/databases/$(database)/documents/fans/$(uid))
            && get(/databases/$(database)/documents/fans/$(uid)).data.n == d.fan);
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /trackCache/{trackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['youtubeId', 'cachedAt'])
        && request.resource.data.youtubeId is string
        && request.resource.data.youtubeId.size() == 11
        && request.resource.data.youtubeId.matches('[A-Za-z0-9_-]{11}')
        && request.resource.data.cachedAt is number
        && trackId.size() <= 200;
      allow update, delete: if false;
    }
    match /leaders/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'sec', 'plays', 'likes', 'status', 'banner', 'frame', 'badges', 'avatar', 'shape', 'now', 'seen', 'fan', 'devOff', 'nemo', 'updatedAt'])
        && (!('nemo' in request.resource.data) || (request.resource.data.nemo is string && request.resource.data.nemo.size() <= 4))
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 32
        && nickFree(request.resource.data)
        && request.resource.data.sec is number && request.resource.data.plays is number && request.resource.data.likes is number
        && request.resource.data.status is string && request.resource.data.status.size() <= 60
        && request.resource.data.banner is string && request.resource.data.banner.size() <= 16
        && request.resource.data.frame is string && request.resource.data.frame.size() <= 16
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 3
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 20000
        && request.resource.data.sec >= 0 && request.resource.data.sec <= 400000000
        && request.resource.data.plays >= 0 && request.resource.data.plays <= 100000000
        && request.resource.data.likes >= 0 && request.resource.data.likes <= 10000000
        && optStr(request.resource.data, 'now', 300) && optStr(request.resource.data, 'shape', 24)
        && fanOk(request.resource.data, uid);
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'status', 'banner', 'bannerImg', 'avatar', 'frame', 'badges', 'bio', 'nickStyle', 'shape', 'effect', 'now', 'seen', 'favArtists', 'favTracks', 'sec', 'plays', 'likes', 'days', 'achCount', 'ach', 'fan', 'devOff', 'nemo', 'updatedAt'])
        && (!('ach' in request.resource.data) || (request.resource.data.ach is list && request.resource.data.ach.size() <= 100))
        && (!('nemo' in request.resource.data) || (request.resource.data.nemo is string && request.resource.data.nemo.size() <= 4))
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 32
        && nickFree(request.resource.data)
        && request.resource.data.status is string && request.resource.data.status.size() <= 60
        && request.resource.data.bannerImg is string && request.resource.data.bannerImg.size() <= 300000
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 90000
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 3
        && request.resource.data.favArtists is list && request.resource.data.favArtists.size() <= 4
        && request.resource.data.favTracks is list && request.resource.data.favTracks.size() <= 10
        && nonNeg(request.resource.data, 'sec', 400000000) && nonNeg(request.resource.data, 'plays', 100000000)
        && nonNeg(request.resource.data, 'likes', 10000000) && nonNeg(request.resource.data, 'days', 100000)
        && nonNeg(request.resource.data, 'achCount', 10000)
        && optStr(request.resource.data, 'bio', 400) && optStr(request.resource.data, 'now', 300)
        && optStr(request.resource.data, 'banner', 24) && optStr(request.resource.data, 'frame', 24)
        && optStr(request.resource.data, 'nickStyle', 32) && optStr(request.resource.data, 'shape', 24)
        && optStr(request.resource.data, 'effect', 32)
        && fanOk(request.resource.data, uid);
    }
    match /friends/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['list', 'declined', 'updatedAt'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 200
        && (!('declined' in request.resource.data) || (request.resource.data.declined is list && request.resource.data.declined.size() <= 300));
    }
    // друзья — только взаимно: каждый есть в списке у другого
    function mutual(a, b) {
      return exists(/databases/$(database)/documents/friends/$(a))
        && exists(/databases/$(database)/documents/friends/$(b))
        && b in get(/databases/$(database)/documents/friends/$(a)).data.list
        && a in get(/databases/$(database)/documents/friends/$(b)).data.list;
    }
    // чат двух друзей: id = uidA_uidB (по алфавиту)
    // в read хранятся: прочитано (uid), огонёк (g_*, gs…), очистка (x_<uid>, xa) и блокировка (b_<uid>)
    function rd(d) { return d.get('read', {}); }
    // чужие пометки «заблокировал» и «очистил у себя» менять нельзя
    function keepFlags(o) {
      return rd(request.resource.data).get('b_' + o, 0) == rd(resource.data).get('b_' + o, 0)
        && rd(request.resource.data).get('x_' + o, 0) == rd(resource.data).get('x_' + o, 0);
    }
    function notBlocked(cid) {
      return !exists(/databases/$(database)/documents/chats/$(cid))
        || (rd(get(/databases/$(database)/documents/chats/$(cid)).data).get('b_' + cid.split('_')[0], 0) == 0
          && rd(get(/databases/$(database)/documents/chats/$(cid)).data).get('b_' + cid.split('_')[1], 0) == 0);
    }
    // группа: id начинается с «g», участники — в members (3–10 человек)
    function isGroupId(cid) { return cid.matches('g[A-Za-z0-9]+'); }
    function chatMembers(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data.members; }
    function inChat(cid) { return request.auth.uid in cid.split('_') || (isGroupId(cid) && request.auth.uid in chatMembers(cid)); }
    match /chats/{cid} {
      allow get: if request.auth != null && (request.auth.uid in cid.split('_') || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      // переписка с другом
      allow create: if request.auth != null && !isGroupId(cid)
        && request.resource.data.members == cid.split('_')
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'last', 'at', 'read'])
        && mutual(cid.split('_')[0], cid.split('_')[1]);
      // группа: создатель добавляет только своих друзей
      allow create: if request.auth != null && isGroupId(cid)
        && request.resource.data.group == true
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['members', 'last', 'at', 'read', 'group', 'name', 'owner'])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 3 && request.resource.data.members.size() <= 10
        && request.auth.uid in request.resource.data.members
        && get(/databases/$(database)/documents/friends/$(request.auth.uid)).data.list.hasAll(request.resource.data.members.removeAll([request.auth.uid]));
      allow update: if request.auth != null && !isGroupId(cid) && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'last', 'at', 'read'])
        && (cid.split('_')[0] == request.auth.uid || keepFlags(cid.split('_')[0]))
        && (cid.split('_')[1] == request.auth.uid || keepFlags(cid.split('_')[1]));
      // группа: писать и переименовывать могут все; состав меняет создатель, выйти может каждый
      allow update: if request.auth != null && isGroupId(cid) && request.auth.uid in resource.data.members
        && request.resource.data.keys().hasOnly(['members', 'last', 'at', 'read', 'group', 'name', 'owner'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.group == true
        && optStr(request.resource.data, 'name', 80)
        && request.resource.data.members is list && request.resource.data.members.size() <= 10
        && (request.resource.data.members == resource.data.members
          || (resource.data.owner == request.auth.uid && request.resource.data.members.hasAll(resource.data.members)
              && get(/databases/$(database)/documents/friends/$(request.auth.uid)).data.list.hasAll(request.resource.data.members.removeAll(resource.data.members)))
          || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]));
      allow delete: if false;
      match /msgs/{mid} {
        allow read: if request.auth != null && inChat(cid);
        allow create: if request.auth != null && inChat(cid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'track', 'img', 'voice', 'vdur', 're'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 400000))
          && (!('voice' in request.resource.data) || (request.resource.data.voice is string && request.resource.data.voice.size() <= 400000))
          && request.resource.data.at is number
          && (isGroupId(cid) || (mutual(cid.split('_')[0], cid.split('_')[1]) && notBlocked(cid)));
        // свои сообщения можно изменить (только текст) — реакции ставит любой участник, только свою
        allow update: if request.auth != null && inChat(cid)
          && ((resource.data.from == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'ed'])
                && request.resource.data.text is string && request.resource.data.text.size() <= 500)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
                && request.resource.data.get('rx', {}).diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])));
        // удалить своё сообщение; «удалить чат у всех» — любой из двоих в переписке
        allow delete: if request.auth != null && inChat(cid)
          && (resource.data.from == request.auth.uid || !isGroupId(cid));
      }
    }
    // «Слушать вместе»: состояние плеера переписки (что играет, с какой секунды)
    match /together/{cid} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      // участник не может подменить состав: он либо прежний, либо настоящий состав переписки
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.members is list && request.auth.uid in request.resource.data.members
        && (request.resource.data.members == resource.data.members
          || request.resource.data.members == cid.split('_')
          || (isGroupId(cid) && request.resource.data.members == chatMembers(cid)));
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list && request.resource.data.members.size() <= 10
        && (request.resource.data.members == cid.split('_') || (isGroupId(cid) && request.resource.data.members == chatMembers(cid)));
    }
    // общий плейлист переписки: пополняют все участники
    match /shared/{pid} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.tracks is list && request.resource.data.tracks.size() <= 300;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
        && request.resource.data.tracks is list && request.resource.data.tracks.size() <= 300
        && (request.resource.data.members == pid.split('_') || (isGroupId(pid) && request.resource.data.members == chatMembers(pid)));
    }
    // «Мне нравится MKW»: номер фаната по порядку. Счётчик и номер пишутся одной транзакцией,
    // каждый может получить номер один раз. Разработчик — №1, первый фанат — №2.
    match /fans/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n', 'at'])
        && request.resource.data.n is int
        && getAfter(/databases/$(database)/documents/meta/fans).data.count == request.resource.data.n;
      allow update, delete: if false;
    }
    match /meta/fans {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 2
        && !exists(/databases/$(database)/documents/fans/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/fans/$(request.auth.uid)).data.n == 2;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && !exists(/databases/$(database)/documents/fans/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/fans/$(request.auth.uid)).data.n == request.resource.data.count;
      allow delete: if false;
    }
    // звонки друзьям (до 4 человек). Сам звук идёт напрямую между телефонами, здесь только «рукопожатие»
    match /calls/{id} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'members', 'in', 'muted', 'ping', 'declined', 'screen', 'at'])
        && request.resource.data.members is list && request.resource.data.members.size() <= 4
        && request.auth.uid in request.resource.data.members
        && request.resource.data['in'] == [request.auth.uid]
        && get(/databases/$(database)/documents/friends/$(request.auth.uid)).data.list.hasAll(request.resource.data.members.removeAll([request.auth.uid]));
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.keys().hasOnly(['host', 'members', 'in', 'muted', 'ping', 'declined', 'screen', 'at'])
        && request.resource.data.host == resource.data.host
        && request.resource.data.members is list && request.resource.data.members.size() <= 4
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data['in'] is list && request.resource.data.members.hasAll(request.resource.data['in']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      match /sig/{sid} {
        allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from', 'to', 'kind', 'sid', 'sdp', 'at'])
          && request.resource.data.sdp is string && request.resource.data.sdp.size() <= 30000
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(id)).data.members
          && request.resource.data.to in get(/databases/$(database)/documents/calls/$(id)).data.members;
        allow update: if false;
      }
    }
    // пуш-уведомления: подписки устройств (до 6). Прочитать их может только сам человек и его взаимные друзья —
    // наш Worker читает их от имени отправителя, когда тот звонит или пишет
    match /push/{uid} {
      // создателю MKW уведомление о новом сообщении об ошибке может отправить любой вошедший
      allow get: if request.auth != null && (request.auth.uid == uid || mutual(request.auth.uid, uid) || uid == 'IqBq9kGF1oZG4Iz0m6LU1nSyx5H2');
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['subs', 'updatedAt'])
        && request.resource.data.subs is list && request.resource.data.subs.size() <= 6;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // опросы: один голос на человека (можно передумать), результаты видят все
    match /polls/{pid}/votes/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['o', 'at'])
        && request.resource.data.o is int && request.resource.data.o >= 0 && request.resource.data.o <= 5;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // значок Contributor: читают все, выдаёт и забирает только создатель (по uid, а не по почте)
    match /contrib/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly(['nick', 'on', 'at']) && request.resource.data.on is bool;
    }
    match /joined/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['month'])
        && request.resource.data.month is string
        && request.resource.data.month.matches('[0-9]{4}-[0-9]{2}');
      allow update, delete: if false;
    }
      // Счётчик прослушиваний трека на MKW за месяц: tplays/{месяц}_{трек}. Только +1 за раз, только вошедшим.
    match /tplays/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id.size() <= 100
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    // «Сообщить об ошибке» и «Оценить оптимизацию»: пишет любой вошедший (только от своего имени), читает и удаляет только создатель
    match /reports/{rid} {
      allow read, delete: if isOwner();
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'nick', 'text', 'score', 'ver', 'att', 'env', 'at', 'up', 'read'])
        && request.resource.data.kind in ['bug', 'rate']
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 32
        && request.resource.data.read == false
        && request.resource.data.att is list && request.resource.data.att.size() <= 4
        && (request.resource.data.kind == 'bug' || (request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 10));
      // вложения кусками до ~1 МБ: добавить может только автор сообщения
      match /parts/{pid} {
        allow read, delete: if isOwner();
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/reports/$(rid)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string && request.resource.data.d.size() <= 1000000;
      }
    }
    // анонимная статистика работы (без uid): пишет любой вошедший, читает только создатель
    match /perf/{pid} {
      allow read, delete: if isOwner();
      allow create, update: if request.auth != null && pid.size() <= 40
        && request.resource.data.keys().hasOnly(['day', 'v', 's', 'dev', 'q', 'm', 'sess', 'fg', 'pr', 'bad', 'med', 'lost', 'st', 'th', 'sv', 'mem', 'err', 'errs', 'lt', 'ltms', 'boot', 'heap', 'net', 'at'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.dev is map && request.resource.data.dev.size() <= 12
        && request.resource.data.errs is list && request.resource.data.errs.size() <= 5;
    }
  }
}
