rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{sub=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /trackCache/{trackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['youtubeId', 'cachedAt'])
        && request.resource.data.youtubeId is string
        && request.resource.data.youtubeId.size() == 11;
      allow update, delete: if false;
    }
    match /leaders/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'sec', 'plays', 'likes', 'status', 'banner', 'frame', 'badges', 'avatar', 'shape', 'now', 'seen', 'updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 32
        && request.resource.data.sec is number && request.resource.data.plays is number && request.resource.data.likes is number
        && request.resource.data.status is string && request.resource.data.status.size() <= 60
        && request.resource.data.banner is string && request.resource.data.banner.size() <= 16
        && request.resource.data.frame is string && request.resource.data.frame.size() <= 16
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 3
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 20000;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'status', 'banner', 'bannerImg', 'avatar', 'frame', 'badges', 'bio', 'nickStyle', 'shape', 'effect', 'now', 'seen', 'favArtists', 'favTracks', 'sec', 'plays', 'likes', 'days', 'achCount', 'updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 32
        && request.resource.data.status is string && request.resource.data.status.size() <= 60
        && request.resource.data.bannerImg is string && request.resource.data.bannerImg.size() <= 300000
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 90000
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 3
        && request.resource.data.favArtists is list && request.resource.data.favArtists.size() <= 4
        && request.resource.data.favTracks is list && request.resource.data.favTracks.size() <= 10;
    }
    match /friends/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['list', 'declined', 'updatedAt'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 200
        && (!('declined' in request.resource.data) || (request.resource.data.declined is list && request.resource.data.declined.size() <= 300));
    }
    match /joined/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['month'])
        && request.resource.data.month is string;
      allow update, delete: if false;
    }
  }
}
